# Where the app sends API requests, including the /api prefix.
#
# `/api` (the default) means this dev server's own origin: Vite proxies it to
# upasana-be (see vite.config.ts), so the browser never makes a cross-origin
# request. Set a full URL instead, e.g. https://api.example.com/api, when the
# frontend is deployed apart from the backend.
#
# The Better Auth client derives its own base URL from this by stripping the
# prefix (src/lib/auth-client.ts), so one variable configures both and they
# cannot drift apart.
#
# Vite only exposes variables prefixed with VITE_ to the browser, and it inlines
# them at build time — changing this needs a rebuild, not a restart.
VITE_API_URL=/api

# Where the dev server's /api proxy forwards to: the upasana-be server.
# Dev only; never reaches the browser.
API_PROXY_TARGET=http://localhost:5000
